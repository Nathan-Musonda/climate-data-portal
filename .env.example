# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=your_database_name
DB_USER=your_username
DB_PASSWORD=your_password

# Flask Configuration
FLASK_ENV=development
SECRET_KEY=your-secret-key-here

# Live weather collection
LIVE_WEATHER_API_URL=
LIVE_WEATHER_API_KEY=your_weather_api_key
LIVE_WEATHER_PERSIST_ENABLED=true
LIVE_WEATHER_HISTORY_DEFAULT_LIMIT=100

# Daily district ingestion can reuse LIVE_WEATHER_API_KEY
DAILY_WEATHER_API_URL=
DAILY_WEATHER_API_KEY=
