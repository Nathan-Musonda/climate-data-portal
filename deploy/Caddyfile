your-domain.example.com {
    encode gzip zstd

    reverse_proxy 127.0.0.1:5000

    header {
        X-Content-Type-Options nosniff
        X-Frame-Options SAMEORIGIN
        Referrer-Policy strict-origin-when-cross-origin
    }

    @static {
        path /static/*
    }
    handle @static {
        header Cache-Control "public, max-age=86400"
        reverse_proxy 127.0.0.1:5000
    }
}
